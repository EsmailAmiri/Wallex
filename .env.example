# Copy to .env and insert your dedicated account's API key locally.
WALLEX_API_KEY=
WALLEX_DASHBOARD_PORT=8766

# Official Wallex Streamable HTTP MCP. Auth: X-API-Key from WALLEX_API_KEY.
WALLEX_MCP_URL=https://api.wallex.ir/mcp
WALLEX_MCP_TOKEN=

# 9router: copy its API key from http://127.0.0.1:20128/dashboard
# This is a separate key; never put the Wallex key here.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=ag/gemini-3.8-flash-medium
LLM_TIMEOUT_SECONDS=20
# live: fetch and cache votes; replay: cache only, no network calls.
LLM_MODE=live
